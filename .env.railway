# Railway Production Environment Variables Template
# Copy this to Railway environment variables for each service

# ===== API SERVICE =====
# Database Configuration (Railway PostgreSQL)
DB_NAME=${{RAILWAY_POSTGRES_DB_NAME}}
DB_USER=${{RAILWAY_POSTGRES_USER}}
DB_PASSWORD=${{RAILWAY_POSTGRES_PASSWORD}}
DB_HOST=${{RAILWAY_POSTGRES_HOST}}
DB_PORT=${{RAILWAY_POSTGRES_PORT}}

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Device Authentication
DEVICE_API_KEY=your-production-device-api-key-change-this

# ===== DASHBOARD SERVICE =====
# API Connection (use Railway-generated URL)
API_BASE_URL=https://your-api-app-name.railway.app/api

# JWT Configuration (must match API service)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Dashboard Configuration
DASHBOARD_PORT=5001
FLASK_ENV=production
