# pi/.env.example — Copy to pi/.env and fill in your values
# =========================================================
# This file is ONLY for the Raspberry Pi hardware agent.
# It is NOT committed to version control.

# ── API connection ──────────────────────────────────────
# URL of your Flask API (no trailing slash)
API_BASE_URL=http://172.16.7.171:5000/api

# Numeric ID from the devices table for this Pi
DEVICE_DB_ID=1

# Pre-shared secret — must match DEVICE_API_KEY in the API's .env
DEVICE_API_KEY=fab17ba24a660177b4cf4c6feb5a10e5ed23bd2f3fb0a8f7

# ── ThingSpeak (secondary cloud backup) ────────────────
THINGSPEAK_API_KEY=O0YOQQGDSJGFZH8P

# ── Timing (seconds) ────────────────────────────────────
SENSOR_READ_INTERVAL=15
API_SEND_INTERVAL=60
COMMAND_POLL_INTERVAL=10
HEARTBEAT_INTERVAL=15

# ── GPIO pins (BCM numbering) ────────────────────────────
GPIO_TURBIDITY=17
GPIO_BUZZER=18
GPIO_LED_BLUE=27
GPIO_LED_YELLOW=22
GPIO_LED_RED=5
GPIO_PUMP=16

# ── Sensors ──────────────────────────────────────────────
RS485_PORT=/dev/ttyUSB0
RS485_SLAVE_ID=1
GSM_PORT=/dev/serial0
GSM_BAUDRATE=9600

# ── SMS numbers (comma-separated) ───────────────────────
SMS_PHONE_NUMBERS=+256764152908,+256770701680
