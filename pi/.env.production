# Production Hardware Monitor Configuration
# Copy this to .env on your Raspberry Pi for production deployment

# ===== API CONNECTION =====
# Replace with your Railway API URL after deployment
API_BASE_URL=https://your-fish-pond-api.railway.app/api

# ===== DEVICE AUTHENTICATION =====
# Must match DEVICE_API_KEY from Railway environment variables
DEVICE_API_KEY=your-production-device-api-key-change-this

# ===== DEVICE CONFIGURATION =====
DEVICE_DB_ID=1

# ===== TIMING INTERVALS (seconds) =====
SENSOR_READ_INTERVAL=15
API_SEND_INTERVAL=60
COMMAND_POLL_INTERVAL=10
HEARTBEAT_INTERVAL=15

# ===== GPIO PINS (BCM numbering) =====
GPIO_TURBIDITY=17
GPIO_BUZZER=18
GPIO_LED_BLUE=27
GPIO_LED_YELLOW=22
GPIO_LED_RED=5
GPIO_PUMP=16

# ===== SENSOR CONFIGURATION =====
RS485_PORT=/dev/ttyUSB0
RS485_SLAVE_ID=1
GSM_PORT=/dev/serial0
GSM_BAUDRATE=9600

# ===== TEMPERATURE SENSOR =====
TEMP_SENSOR_PATH=/sys/bus/w1/devices/28-4336d4437148/w1_slave

# ===== SMS NOTIFICATIONS =====
SMS_PHONE_NUMBERS=+256764152908,+256770701680

# ===== THINGSPEAK (optional) =====
THINGSPEAK_API_KEY=your_thingspeak_key_here
THINGSPEAK_CHANNEL_ID=your_channel_id_here
