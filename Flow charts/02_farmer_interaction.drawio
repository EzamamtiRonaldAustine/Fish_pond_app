        <mxCell id="ea3" style="dashed=1;" edge="1" source="act5" target="act2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Step 3: View Dashboard -->
        <mxCell id="act6" value="3. Views live pond data" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="act7" value="GET /current-readings" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
