        <!-- Step 1: Login -->
        <mxCell id="act1" value="1. Opens login page" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="50" y="160" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="act2" value="Shows Login / Google button" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="255" y="160" width="195" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ea1" edge="1" source="act1" target="act2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Step 2: Auth -->
        <mxCell id="act3" value="2. Submits credentials" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="act4" value="POST /auth/login or /google" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="495" y="250" width="195" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ea2" edge="1" source="act3" target="act4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="act5" value="Returns JWT Access Token" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
