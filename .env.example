# .env.example — API server environment variables
# ===================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Flask
SECRET_KEY=your_very_long_random_secret_key
FLASK_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/fishpond_db
DB_NAME=fishpond_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET_KEY=your_jwt_secret_key

# Hardware agent authentication
# This must match DEVICE_API_KEY in pi/.env
DEVICE_API_KEY=CHANGE_ME_DEVICE_SECRET
