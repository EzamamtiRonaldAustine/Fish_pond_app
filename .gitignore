# .gitignore — Smart Fish Pond Monitoring System

# --- Environment & Secrets ---
.env
.env.local
.env.production
.env.railway
*.pem
*.key
*.crt

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
env/
*.egg-info/
dist/
build/
.cache/
.pytest_cache/
.coverage
htmlcov/

# --- Local Development & Configuration ---
.vscode/
.idea/
*.swp
*.bak
*.backup
Thumbs.db
.DS_Store
webServerApiSettings.json

# --- Database & Data ---
*.db
*.sql
!database/*.sql   # Preserve schema files in the database directory
local_test_data.sql

# --- Large Files ---
*.xlsx
*.xls
!IoTPond6.xlsx    # Keep the sample data file mentioned previously

# --- Logs ---
*.log
logs/

# --- Temporary / Deployment ---
railway-temp/
*.tmp
*.temp
.railway/
dashboard/templates/ml_analysis.html # Unused template